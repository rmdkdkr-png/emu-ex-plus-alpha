module;
#include <mednafen/mednafen.h>
#include <ngp/mem.h>
#include <ss2sp/ss2sp.h>
#include <svcsp/svcsp.h>
#include <ss2comm/ss2comm.h>

export module system;
import emuex;
import imagine;
import std;

extern "C++" const Mednafen::MDFNGI EmulatedNGP;

namespace EmuEx
{

using namespace IG;

export enum class NgpKey: KeyCode
{
	Up = 1,
	Right = 4,
	Down = 2,
	Left = 3,
	Option = 7,
	A = 5,
	B = 6,
	/* ── SS2 원버튼 필살기 트리거 ──────────────────────────────
	   1~7은 NGP 실기 패드 비트와 1:1이라 건드리면 안 된다(bit(code-1)).
	   8부터는 실기에 없는 가상 키다 — 패드 바이트로 가지 않고
	   엔진 트리거 비트로만 쓰인다. */
	/* 엔진(ss2sp_frame)은 트리거 비트를 9개까지 읽는다.
	   v0.5: 쓰는 것은 SP1 하나뿐이다. 비오의는 **뒤+A+B** 로 옮겼다(엔진이 패드에서 직접 읽는다).
	   SP2~SP8 은 키 코드만 남겨 둔다 — 옛 설정이 남아 있어도 엔진이 무시한다.
	   분노 MAX 일 때만 나가는 기술이라 방향 조합에 끼워 두면 평소엔 죽은 자리가 된다.
	   그 대신 기술이 8개인 유파(한조·나찰)는 마지막 기술 하나가 버튼 직결에서 밀린다.
	   그 기술도 SP+방향 자리에는 그대로 있다. */
	SP1 = 8,
	SP2 = 9,
	SP3 = 10,
	SP4 = 11,
	SP5 = 12,
	SP6 = 13,
	SP7 = 14,
	SP8 = 15,
	/* A+B 동시입력 = 분노 폭발. 손가락 두 개로 정확히 같은 프레임에 누르기가 어려워서
	   버튼 하나로 만든다. 엔진과 무관하게 패드 비트 두 개(A 0x10 / B 0x20)를 같이 켤 뿐이다. */
	AB = 16,
	/* v0.7: 해설자 교대. 버튼 하나로 다음 사람에게 넘긴다 —
	   설정 메뉴를 열지 않고 판 중에 바꾸려는 것이다(브라우저판은 해설창 얼굴을 누른다).
	   실기 패드로 가지 않는 가상 키라 패드 바이트를 건드리지 않는다. */
	CommNext = 17,
	/* v0.9: 빠른 설정 오버레이 — 게임 화면 위에 설정창을 직접 띄운다.
	   열려 있는 동안 방향·A·B 는 게임 대신 설정창으로 간다. */
	CommMenu = 18,
};

/* 엔진 선언은 ss2sp/ss2sp.h (global module fragment 에서 include) */

/* 기술 배치 저장 형식 — 유파 30 × 슬롯 7 = 210바이트. ss2sp_slots_size() 와 같아야 한다. */
export using Ss2SlotBlob = std::array<uint8_t, 210>;

enum NgpConfigKey
{
	CFGKEY_NGPKEY_LANGUAGE = 269, CFGKEY_NO_MD5_FILENAMES = 270,
	/* SS2 원버튼 */
	CFGKEY_SS2SP_SLOTS = 271, CFGKEY_SS2SP_ENABLED = 272, CFGKEY_SS2SP_LAYOUT = 273,
	CFGKEY_SS2COMM_ENABLED = 274, CFGKEY_SS2COMM_SPK = 275, CFGKEY_SS2COMM_DRAW = 276,
	CFGKEY_SS2COMM_VIBRATE = 277, CFGKEY_SS2COMM_REF = 278, CFGKEY_SS2COMM_SIDES = 279,
	CFGKEY_SS2COMM_SCENECAP = 280, CFGKEY_SS2COMM_SIDEBG = 281,
	CFGKEY_SS2_FRAMEGEN = 282, CFGKEY_SS2_FRAMEGEN_MULT = 283, CFGKEY_SS2_RUNAHEAD = 284,
	CFGKEY_SS2_FRAMEGEN_FX = 285, CFGKEY_SS2_FRAMEGEN_POSE = 286, CFGKEY_SS2_FRAMEGEN_IDLE = 287,
};

export class NgpSystem final: public EmuSystem
{
public:
	Mednafen::MDFNGI mdfnGameInfo{EmulatedNGP};
	/* false = Japanese, true = English (ngp.language: japanese=0 / english=1).
	   한글 패치본은 일본어 자리에 들어가므로 기본값을 Japanese 로 둔다. */
	Property<bool, CFGKEY_NGPKEY_LANGUAGE,
	{
		.defaultValue = false
	}> optionNGPLanguage;
	uint8_t inputBuff{};
	uint16_t spTrig{};        /* SP 눌림 비트 (지금은 비트0 = SP 만 쓴다) */
	bool ss2spEnabled{true};  /* 옵션에서 끌 수 있다 */
	/* .emu 계열은 화면 버튼을 많이 못 얹고 핫키도 빈약하다.
	   그래서 기본을 **SP 하나 + 방향**으로 둔다 — 브라우저 실행기와 같은 감각.
	   물리 패드를 쓰면 SP2~SP6 이 기술 1~5번으로 그대로 살아 있다. */
	/* SP1-8 낱개 배치는 없앴다 — 기술은 전부 SP+방향으로 나간다. 고를 것이 없어 상수다. */
	static constexpr bool ss2spLayoutSP = true;
	/* SS2 캐릭터 해설 — 화면 하단 알림으로 한 줄씩. 화자 0 하오마루 1 나코루루 2 한조 3 갈포드 */
	bool ss2commEnabled{true};
	uint8_t ss2commSpeaker{};
	/* 큰 장면에서 짧게 울린다. 화면 버튼 햅틱(VController)과는 **완전히 별개**라
	   버튼 진동을 꺼 둔 채로도 이것만 켤 수 있다. */
	bool ss2commVibrate{};
	bool ss2commRef{true};           /* 심판(쿠로코) — 온이면 해설창을 심판이 우선 쓴다 */
	bool ss2commSides{true};         /* 양옆 아트웍 기둥 — 넓은 화면의 빈 좌우를 채운다 */
	bool ss2commSceneCap{};
	bool ss2ovComboLatch{};          /* 위+옵션 콤보 한 번만 발동 래치 */          /* 장면 수집 — 세이브스테이트 때마다 상태·램·화면을 덤프 */
	/* 해설을 어디에 보여 줄까 — 0 알림 줄 / 1 게임 화면 **위**에 띠를 붙여 직접 그린다.
	   띠 모드는 화자 얼굴까지 나온다. 얼굴은 배포물에 넣지 않고 사용자 롬에서 뽑는다. */
	/* 게임 160×152 위에 32px 띠를 붙일 수 있게 버퍼를 처음부터 크게 잡아 둔다.
	   띠를 끄면 아래 152줄만 커밋하므로 화면은 원래대로 돌아간다. */
	/* 위 32줄 = 해설 띠. 심판(쿠로코)은 제 칸이 없다 — 게임 화면 맨 아래 32줄에
	   **오버레이**로 얹힌다(대사가 서 있는 동안만). 32 인 이유는 쿠로코 초상이
	   32x32(선택 화면 아이콘)뿐이기 때문이다. */
	static constexpr int ss2GameW = 160, ss2GameH = 152, ss2BandH = 32, ss2RefH = 32, ss2SideW = 64;
	MutablePixmapView mSurfacePix;   /* 게임이 그려지는 자리 (띠를 켜면 32줄 아래) */
	MutablePixmapView mFullPix;      /* 띠까지 포함한 버퍼 전체 */
	/* 좌우 기둥까지 담는 폭 — 기둥을 끄면 가운데 폭만 서브뷰로 올린다 */
	static constexpr WSize vidBufferPx{ss2GameW + 2*ss2SideW, ss2GameH + ss2BandH};
	alignas(8) uint32_t pixBuff[vidBufferPx.x * vidBufferPx.y]{};
	/* ss2comm_draw() 는 RGB565 전용이다. 화면이 32비트로 돌 때는 여기 그린 뒤 변환해 얹는다. */
	uint16_t ss2BandScratch[ss2GameW * (ss2GameH + ss2BandH)]{};
	bool noMD5InFilenames{};
	// TODO: Mednafen/Neopop timing is based on 199 lines/frame, verify if this is correct
	static constexpr FrameRate ngpFrameRate{6144000. / (199. * 515.)}; //~59.95Hz
	static constexpr SystemLogger log{"NGP.emu"};

	NgpSystem(ApplicationContext ctx):
		EmuSystem{ctx}
	{
		Mednafen::MDFNGameInfo = &mdfnGameInfo;
		mdfnGameInfo.SetInput(0, "gamepad", (uint8*)&inputBuff);
		ss2sp_set_ram(MDFN_IEN_NGP::CPUExRAM);
		svcsp_set_ram(MDFN_IEN_NGP::CPUExRAM);
		ss2comm_set_ram(MDFN_IEN_NGP::CPUExRAM);
		ss2comm_overlay_bind(reinterpret_cast<unsigned char*>(&ss2commEnabled), &ss2commSpeaker,
			reinterpret_cast<unsigned char*>(&ss2commRef), reinterpret_cast<unsigned char*>(&ss2commSides),
			nullptr /* 기둥 배경 옵션 폐지 */, reinterpret_cast<unsigned char*>(&ss2commVibrate),
			reinterpret_cast<unsigned char*>(&ss2commSceneCap),
			reinterpret_cast<unsigned char*>(&ss2spEnabled));
	}

	// required API functions
	void loadContent(IO&, EmuSystemCreateParams, OnLoadProgressDelegate);
	[[gnu::hot]] void runFrame(EmuSystemTaskContext, EmuVideo*, EmuAudio*);
	FS::FileString stateFilename(int slot, std::string_view name) const;
	std::string_view stateFilenameExt() const { return ".mca"; }
	size_t stateSize();
	void readState(EmuApp&, std::span<uint8_t> buff);
	size_t writeState(std::span<uint8_t> buff, SaveStateFlags);
	void ss2SceneDump(std::span<uint8_t> state);
	void ss2SceneAuto();
	bool readConfig(ConfigType, MapIO&, unsigned key);
	/* 띠를 켜면 세로가 32줄 늘어난다 — 화면비를 그만큼 되돌린다.
	   PCE.emu 가 보이는 줄 수를 바꿀 때 쓰는 것과 같은 자리다. */
	double videoAspectRatioScale() const;
	/* ── 프레임 생성 (120Hz) ──
	   「프레임 타이밍 → 화면 주사율 덮어쓰기 = 120Hz」로 두면 vsync 두 번에 한 번은 빈 슬롯이 된다.
	   그 슬롯에서 상태를 저장한 채 다음 프레임을 미리 돌려(소리 뮤트) 현재↔다음 중간 자리에
	   현재 프레임의 타일을 다시 그려 올린다 — 추가 지연 0. 코어판 ss2fg 와 같은 엔진. */
	/* 0 끔 · 1 켬(빈 vsync 슬롯이 오면 120 출력, 아니면 60Hz 사이 그림) · 2 60Hz 사이 그림만(120 출력 안 함 — 코어판 ngp_framegen=60, 패치 90).
	   60Hz 사이 그림: 사무쇼2는 캐릭터·배경이 2프레임마다(30Hz) 바뀌므로, 4배의 2프레임 예측(ss2Predict4)을 그대로 돌려
	   실제 프레임마다 τ=D 그림만 표면에 그린다(τ=D+½ 는 안 만듦) — 30→60Hz, 지연 없음, 런어헤드와 같이(D=N+2) */
	uint8_t ss2FrameGen{1};
	uint8_t ss2FrameGenMult{4};         /* 4 = 게임 박자 맞춤(N+1·N+2 예측, 사무쇼2는 2프레임에 한 번 움직인다) · 2 = 반 프레임 하나 */
	bool interFrame(EmuSystemTaskContext, EmuVideo &);
	bool ss2PredictFrame();
	/* 4배 — 코어판 libretro.c 의 fg_predict4 와 같은 절차. 실제 N 을 돌린 직후 N+1·N+2 를 미리 돌려
	   τ=N 그림은 표면에 덮어 그리고 τ=N+½ 은 ss2FgNext 에 보관했다가 빈 vsync 슬롯에 올린다.
	   커밋은 Emulate 가 끝난 뒤로 미룬다(ss2FgCommitPending). 빈 슬롯이 실제로 오는 동안만(120Hz) 쓴다. */
	bool ss2Predict4(int ra);
	/* 런어헤드 — 사무쇼2는 입력이 2~3프레임 뒤에 화면에 나오므로, 실제 N 뒤 N+1·N+2 를 숨겨 돌리고 N+2 의 그림을
	   보여 준다(코어판 ra_frames/fg_hidden 과 같은 절차). 4배와 같이 돌 때는 보여 주는 시간줄을 앞당긴다. */
	uint8_t ss2RunAhead{2};             /* 2·1·0 */
	/* 이펙트·장풍 — 겉모습·몸·물체로 못 정한 이펙트 무리: 1 옮기기(물체 등속·몸에 붙음·테두리 등속) · 2 옮기기+못 정한 것은 반투명 섞기 · 0 끔.
	   코어판 ngp_framegen_fx 와 같은 엔진(ss2fg_set_fx). 그릴 때마다 엔진에 넘긴다 */
	uint8_t ss2FrameGenFx{1};
	/* 날아가는 몸 포즈 — 맞고 빙글빙글 날아갈 때 번갈아 바뀌는 몸 포즈를 중간 그림에서 반투명으로 이음. 1 섞기(기본) · 0 끔. 코어판 ngp_framegen_pose */
	uint8_t ss2FrameGenPose{1};
	/* 서기 자세 — 서 있을 때 숨 쉬듯 1~2픽셀씩 바뀌는 포즈(6~8장 순환) 사이를 4배 격자에 ¼픽셀씩 옮겨 그려 잇는다(코어판 ngp_framegen_idle, 패치 95).
	   켜면 사무쇼2 게임 화면(띠·기둥 없을 때)을 640×608 로 올린다 — 조각 밖은 단순 4배라 보기엔 같다. 1 그리기(기본) · 0 끔 */
	uint8_t ss2FrameGenIdle{1};
	int ss2IdleSlot{-1};                /* 이번 출력이 쓸 서기 조각 칸: 0 τD(실제 프레임) · 1 τD+½(빈 슬롯) · -1 없음 */
	std::vector<uint8_t> ss2Idle4;      /* 4배 출력 버퍼(화면 형식 그대로) */
	bool ss2IdleActive() const;         /* 서기 그리기가 지금 4배로 내보내는 중인가(사무쇼2·프레임 생성 켬·띠·기둥 없음) */
	PixmapView ss2IdleOut(MutablePixmapView pix, int slot);   /* pix 가 게임 화면(160×152)이면 4배로 늘려 조각을 붙인 그림, 아니면 pix 그대로 */
	int ss2RaFrames() const;            /* 지금 쓸 런어헤드 프레임 수(0 = 안 씀) */
	bool ss2RaPlain(int ra);            /* 프레임 생성 없이 런어헤드만 — 표면에 N+ra 그림 */
	bool ss2Hidden(int n, int keep);    /* 입력을 붙잡은 채 n 프레임 숨겨 돌린다, keep 번째 그림은 표면에 남긴다 */
	bool ss2SnapSave();
	void ss2SnapLoad(int pops);
	bool ss2SlotsComing() const { return ss2FrameNo - ss2FgLastInter <= 2; }   /* 빈 vsync 슬롯이 오고 있다(120Hz) */
	bool ss2FourXActive() const { return ss2FrameGen == 1 && ss2FrameGenMult == 4 && ss2SlotsComing(); }
	/* 60Hz 사이 그림 길: 「60Hz 사이 그림만」이거나, 켬인데 120 슬롯이 안 오는 동안(60Hz 화면·덮어쓰기 안 함) */
	bool ss2SixtyPath() const { return ss2FrameGen == 2 || (ss2FrameGen == 1 && !ss2SlotsComing()); }
	bool ss2FgNoNext{};                 /* 60Hz 사이 그림 — ss2Predict4 가 τ=D 만 그리고 τ=D+½(ss2FgNext)는 건너뛴다 */
	bool ss2FgCommitPending{};
	bool ss2FgNextOk{};
	std::vector<uint8_t> ss2FgNext;
	uint32_t ss2FrameNo{}, ss2FgRealN{}, ss2FgLastSpr{}, ss2FgLastScr{}, ss2FgLastInter{};
	uint32_t ss2FgLastBody[2]{};        /* 몸 따로 박자 — 몸 0·1 의 자리가 마지막으로 바뀐 실제 프레임 */
	bool ss2BandOn() const { return ss2commEnabled || ss2commRef; }   /* 어느 쪽이든 켜면 띠가 선다 */
	bool ss2SidesOn() const { return ss2commSides; }   /* 기둥은 챗/심판과 독립 — 꺼도 대진 추적은 돈다 */
	void ss2SyncSurface();              /* 게임이 그려질 자리를 띠 유무에 맞춘다 */
	MutablePixmapView ss2CommitPix();   /* 띠를 그리고, 화면에 올릴 그림을 돌려준다 */
	void writeConfig(ConfigType, FileIO&);
	void reset(EmuApp&, ResetMode mode);

	void clearInputBuffers()
	{
		inputBuff = {};
		spTrig = {};
		ss2sp_reset();
		svcsp_reset();
		ss2comm_reset();
		MDFN_IEN_NGP::storeB(0x6F82, 0);
	}

	void handleInputAction(EmuApp *appPtr, InputAction a)
	{
		if(a.code == KeyCode(NgpKey::CommMenu))
		{
			if(a.state == Input::Action::PUSHED)
			{
				ss2comm_overlay_toggle();
				/* 여닫는 순간 눌려 있던 키 잔상 제거 — 게임이 이어받지 않게 */
				inputBuff = {};
				if(!ss2spEnabled)
					MDFN_IEN_NGP::storeB(0x6F82, inputBuff);
			}
			return;
		}
		if(ss2comm_overlay_active() &&
		   a.code >= KeyCode(NgpKey::Up) && a.code <= KeyCode(NgpKey::Option))
		{
			/* 설정창이 열려 있다 — 방향·A·B·옵션은 설정창 몫, 게임엔 안 보낸다 */
			if(a.state == Input::Action::PUSHED)
			{
				int k = -1;
				switch(NgpKey(a.code))
				{
					case NgpKey::Up:     k = 0; break;
					case NgpKey::Down:   k = 1; break;
					case NgpKey::Left:   k = 2; break;
					case NgpKey::Right:  k = 3; break;
					case NgpKey::A:      k = 4; break;
					case NgpKey::B:      k = 5; break;
					case NgpKey::Option: k = 5; break;   /* 옵션 = 닫기 */
					default: break;
				}
				if(k >= 0)
					ss2comm_overlay_input(k);
			}
			return;
		}
		if(a.code == KeyCode(NgpKey::CommNext))
		{
			if(a.state != Input::Action::PUSHED)
				return;
			ss2commSpeaker = (uint8_t)ss2comm_next_speaker(1);
			/* 바뀐 해설자는 해설 띠에 그대로 알린다 — 토스트를 쓰면 같은 말이 두 군데 뜬다.
			   이름을 앞에 덧붙이지 않는다. 소개 대사가 이미 제 이름을 말하고 있어서
			   「겐주로 — 키바가미 겐주로다…」처럼 두 번 나왔다. 초상도 같이 뜬다. */
			ss2comm_notify(ss2comm_speaker_hello(ss2commSpeaker));
			return;
		}
		if(a.code == KeyCode(NgpKey::AB))
		{
			/* A(비트4) + B(비트5)를 한 번에 */
			inputBuff = setOrClearBits(inputBuff, uint8_t(bit(4) | bit(5)),
			                           a.state == Input::Action::PUSHED);
			if(!ss2spEnabled)
				MDFN_IEN_NGP::storeB(0x6F82, inputBuff);
			return;
		}
		if(a.code >= KeyCode(NgpKey::SP1) && a.code <= KeyCode(NgpKey::SP8))
		{
			/* 가상 키 — 패드 바이트에 넣지 않는다. 엔진이 프레임마다 읽어 간다. */
			const uint16_t m = uint16_t(1u << (a.code - KeyCode(NgpKey::SP1)));
			if(a.state == Input::Action::PUSHED) spTrig |= m;
			else                                 spTrig &= uint16_t(~m);
			return;
		}
		inputBuff = setOrClearBits(inputBuff, bit(a.code - 1), a.state == Input::Action::PUSHED);
		/* 기본 제스처: 아래+옵션 동시 누름 = 빠른 설정 (위는 점프라 안 된다 — 제보) */
		{
			constexpr uint8_t comboMask = uint8_t(bit(1) | bit(6));   /* Down + Option */
			if((inputBuff & comboMask) == comboMask)
			{
				if(!ss2ovComboLatch)
				{
					ss2ovComboLatch = true;
					ss2comm_overlay_toggle();
					inputBuff = {};   /* 게임이 점프·일시정지로 받지 않게 비운다 */
				}
			}
			else if(!(inputBuff & comboMask))
				ss2ovComboLatch = false;
		}
		/* 엔진이 켜져 있으면 패드는 runFrame 에서 한 번에 쓴다 */
		if(!ss2spEnabled)
			MDFN_IEN_NGP::storeB(0x6F82, inputBuff);
	}

	FrameRate frameRate() const { return ngpFrameRate; }
	void configAudioRate(FrameRate outputFrameRate, int outputRate);

	// optional API functions
	void closeSystem();
	void loadBackupMemory(EmuApp&);
	void onFlushBackupMemory(EmuApp&, BackupMemoryDirtyFlags);
	WallClockTimePoint backupMemoryLastWriteTime(const EmuApp&) const;
	bool onVideoRenderFormatChange(EmuVideo&, PixelFormat);
};

export using MainSystem = NgpSystem;

class NgpApp final: public EmuApp
{
public:
	NgpApp(ApplicationInitParams initParams, ApplicationContext& ctx):
		EmuApp{initParams, ctx}, system_{ctx} {}

	auto& system(this auto&& self) { return self.system_; }

private:
	NgpSystem system_;
};

export using MainApp = NgpApp;

}
